# Copy to .env and supply your own key. Shell variables override .env.
RUNWARE_API_KEY=
JUDGE_PROVIDER=runware
# User-selected alternative to the benchmark's original GPT-4o snapshot.
RUNWARE_JUDGE_MODEL=openai:gpt@6-luna
# For direct OpenAI instead: JUDGE_PROVIDER=openai and OPENAI_API_KEY=...
# OPENAI_API_KEY=
# JUDGE_BASE_URL=  # optional override; default Runware https://api.runware.ai/v1
# TARGET_API_KEY=local
